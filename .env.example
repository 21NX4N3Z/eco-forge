# EcoForge environment (copy to .env — never commit .env)
# Vercel serverless proxy holds the key server-side; frontend never sees it.
OPENROUTER_API_KEY=sk-or-...
VITE_USE_API_WHY=true

# Firebase Auth (optional Phase B) — leave blank to run in offline mock mode
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# NocoDB (Phase C, read-only pull) — leave blank to run on local seed.
# The app calls the server-side proxy /api/noco (api/noco.ts) — NOCODB_* env
# lives ONLY on Vercel (never VITE_-prefixed, never in the client bundle).
# Vercel env: NOCODB_BASE_URL, NOCODB_API_TOKEN,
#   NOCODB_TABLES={"materials":"m1abc","processes":"m2def","cbam_rates":"m3ghi",
#                  "suppliers":"m4jkl","material_mixes":"m5mno"}
# Any failure (unconfigured / timeout / unreachable) silently falls back to
# local seed — the demo never breaks.
