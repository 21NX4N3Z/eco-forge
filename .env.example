# EcoForge environment (copy to .env — never commit .env)
# Vercel serverless proxy holds the key server-side; frontend never sees it.
NOUS_API_KEY=sk-nou...iKrZ
VITE_USE_API_WHY=true

# Firebase Auth (optional Phase B) — leave blank to run in offline mock mode
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# NocoDB (Phase C, read-only pull) — leave blank to run on local seed.
# App pulls materials/processes/cbam_rates/suppliers/material_mixes with a 3s
# timeout; any failure silently falls back to local seed (demo never breaks).
# VITE_NOCODB_BASE_URL=https://your-instance.nocodb.com
# VITE_NOCODB_API_TOKEN=xc-...
# Table ids per collection, e.g. {"materials":"m1abc","processes":"m2def",
#   "cbam_rates":"m3ghi","suppliers":"m4jkl","material_mixes":"m5mno"}
# VITE_NOCODB_TABLES=
