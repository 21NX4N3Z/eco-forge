# EcoForge environment (copy to .env — never commit .env)
# Vercel serverless proxy holds the key server-side; frontend never sees it.
NOUS_API_KEY=your_nous_portal_key_here
VITE_USE_API_WHY=true
# Firebase Auth (optional Phase B) — leave blank to run in offline mock mode
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
